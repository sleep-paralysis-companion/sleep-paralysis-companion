// Copy to Local.xcconfig for developer-only public configuration.
// Local.xcconfig is ignored. Never place passwords, tokens, service-role keys,
// Apple signing secrets, or other credentials in an xcconfig or Info.plist.
SPC_PUBLIC_API_BASE_URL =
SPC_ALLOWED_API_HOSTS =
SPC_PRODUCTION_API_HOSTS =
SPC_AUDIO_CATALOG_MANIFEST_URL =
SPC_AUDIO_CATALOG_AUTHORIZATION_URL =
SPC_AUDIO_CATALOG_ALLOWED_HOSTS =
// Public client configuration only. Never place a service-role or secret key here.
SPC_SUPABASE_PUBLISHABLE_KEY = sb_publishable_replace_with_project_key
// Must exactly match an approved Supabase Auth redirect allow-list entry.
SPC_OAUTH_REDIRECT_URL =
